def cmd_diff(args):
    a = _load_snapshot(args.old)
    b = _load_snapshot(args.new)
    common = [n for n in a if n in b]
    if not common:
        die(EXIT_PATCH, "两份快照没有同名记录可比")
    total = 0
    stub = []
    for name in common:
        da, db = a[name], b[name]
        if len(da) != len(db):
            say("!! %s 长度不同: %d -> %d（布局变了，偏移不可直接沿用）"
                % (name, len(da), len(db)))
        diffs = [(i, da[i], db[i]) for i in range(min(len(da), len(db))) if da[i] != db[i]]
        if not diffs:
            say("%s: 字节完全相同" % name)
            continue
        say("%s: %d 处差异" % (name, len(diffs)))
        for off, x, y in diffs:
            ctx = da[max(0, off - 4):off + 5]
            say("   0x%03x  %02x -> %02x   上下文 %s" % (off, x, y, ctx.hex(" ")))
            stub.append((off, x, y))
        total += len(diffs)
    say("")
    say("合计 %d 处差异" % total)
    if total and args.out:
        guid_line = ("GUID     = %s" % args.guid.upper()) if args.guid \
            else "GUID     = <填变量存储的 GUID>"
        lines = [
            "# 由 `insyde-nvram diff` 生成 —— 保存前逐行核对，尤其确认 TO 是你想要的值。",
            "# 差分法只证明「改了之后这些字节变了」，不证明这些字节就是你以为的那个设置项。",
            "# 验证方式：改回去再快照一次，差异应当只剩这几处。",
            "NAME     = %s" % (args.name or "diff-candidate"),
            "VARSTORE = SystemConfig",
            guid_line,
            "RECORDS  = %s" % ",".join(common),
            "",
        ]
        for off, x, y in stub:
            lines.append("CHANGE   = 0x%03X 0x%02X 0x%02X" % (off, x, y))
        with open(args.out, "w", encoding="utf-8") as fh:
            fh.write("\n".join(lines) + "\n")
        say("候选补丁已写出: %s" % args.out)
        say("  注意：如果两份快照之间在 BIOS 里改了不止一项，这里会混在一起 —— 一次只改一项。")
    return EXIT_OK


def cmd_check(args):
    p = parse_patch(args.patch)
    if not p["ok"]:
        die(EXIT_PATCH, "补丁有问题: %s" % p["err"])
    say("补丁      %s" % p["name"])
    say("文件      %s" % p["path"])
    say("变量存储  %s (%s)" % (p["varstore"] or "-", p["guid"]))
    say("记录      %s" % ", ".join(p["records"]))
    say("")
    rc = EXIT_OK
    for rec in p["records"]:
        try:
            attrs, data = read_var(p["guid"], rec)
        except RuntimeError as e:
            say("%s: 读不到 —— %s" % (rec, e))
            rc = EXIT_BLIND
            continue
        say("%s  %d 字节  attrs=0x%08x" % (rec, len(data), attrs))
        for c in p["changes"]:
            cur = data[c["off"]] if c["off"] < len(data) else None
            if cur is None:
                say("   0x%03X  越界" % c["off"])
                rc = EXIT_LAYOUT
            elif cur == c["from"]:
                say("   0x%03X  当前 0x%02X  →  0x%02X   可应用" % (c["off"], cur, c["to"]))
            elif cur == c["to"]:
                say("   0x%03X  当前 0x%02X  （已是目标值）" % (c["off"], cur))
            else:
                say("   0x%03X  当前 0x%02X  ≠ FROM 0x%02X  ≠ TO 0x%02X  不匹配"
                    % (c["off"], cur, c["from"], c["to"]))
                rc = EXIT_LAYOUT
    say("")
    say("结论: %s" % {EXIT_OK: "可以应用", EXIT_LAYOUT: "偏移/取值对不上，别写",
                     EXIT_BLIND: "有记录读不到"}.get(rc, "异常"))
    return rc


def cmd_probe(args):
    """只把原字节写回，用于判定固件是否允许 OS 侧 SetVariable。"""
    gate_root()
    stores = discover_setup_stores()
    guid = args.guid.upper() if args.guid else None
    if not guid:
        cand = [g for g, v in stores.items() if any(r["name"] == args.record for r in v)]
        if len(cand) != 1:
            die(EXIT_PATCH, "无法唯一确定 GUID，用 --guid 指定")
        guid = cand[0]

    attrs, data = read_var(guid, args.record)
    say("探针目标  %s / %s" % (guid, args.record))
    say("数据长度  %d 字节  attrs=0x%08x (%s)" % (len(data), attrs, _attr_words(attrs)))
    say("")
    say("这个命令做且只做一件事：把当前字节原样写回，然后回读比对。")
    say("它不会改动任何一个值。失败只说明通道不可用，不会造成副作用。")
    if not args.yes:
        ans = input("\n输入 PROBE 继续: ").strip()
        if ans != "PROBE":
            say("已取消")
            return EXIT_PATCH
    try:
        cleared = write_var(guid, args.record, data)
    except RuntimeError as e:
        say("")
        say("写入失败: %s" % e)
        say("")
        say("VERDICT: WRITE_BLOCKED")
        return EXIT_CHANNEL_DENIED
    say("immutable 标志: %s" % ("已清除" if cleared else "无需清除"))
    _a2, after = read_var(guid, args.record)
    if after == data:
        say("回读比对: 完全一致")
        say("")
        say("VERDICT: WRITE_OK —— efivarfs 通道可用，可以应用补丁")
        return EXIT_OK
    diff = [i for i in range(min(len(data), len(after))) if data[i] != after[i]]
    say("回读比对: 不一致，%d 处" % len(diff))
    for i in diff[:20]:
        say("   0x%03X  %02x -> %02x" % (i, data[i], after[i]))
    say("")
    say("VERDICT: WRITE_MUTATED —— 写入被接受但固件改了字节，不要在这个通道上做真实改动")
    return EXIT_CHANNEL_MUTATED


def cmd_apply(args):
    logpath = os.path.join(LOGDIR, "apply_%s.txt" % _stamp())
    say("insyde-nvram apply —— 通过 efivarfs 写入补丁字节")
    say("时间      %s" % time.strftime("%Y-%m-%d %H:%M:%S"))
    gate_root()

    p = parse_patch(args.patch)
    if not p["ok"]:
        flush_log(logpath)
        die(EXIT_PATCH, "补丁有问题: %s" % p["err"])
    say("补丁      %s" % p["name"])
    say("GUID      %s  记录 %s" % (p["guid"], ", ".join(p["records"])))
    gate_machine(args.force)
    say("门禁[加密] 检查中…")
    gate_encryption(args.force)

    live = {}
    for rec in p["records"]:
        try:
            attrs, data = read_var(p["guid"], rec)
        except RuntimeError as e:
            flush_log(logpath)
            die(EXIT_ENGINE, str(e))
        live[rec] = data
        say("读取      %-12s %d 字节  attrs=0x%08x" % (rec, len(data), attrs))

    gate_layout(p, {k: len(v) for k, v in live.items()}, args.force)
    gate_values(p, live, args.force)

    # 目标数据
    target = {}
    for rec, data in live.items():
        buf = bytearray(data)
        for c in p["changes"]:
            buf[c["off"]] = c["to"]
        target[rec] = bytes(buf)
        for c in p["changes"]:
            if bytes(buf[c["off"]:c["off"] + 1]) != bytes([c["to"]]):
                flush_log(logpath)
                die(EXIT_SANITY, "合理性检查失败: %s 0x%03X 未变成 0x%02X"
                    % (rec, c["off"], c["to"]))

    say("")
    say("将要发生的改动：")
    for rec in p["records"]:
        for c in p["changes"]:
            say("   %-12s 0x%03X  0x%02X → 0x%02X" % (rec, c["off"], live[rec][c["off"]], c["to"]))
    say("")

    if args.dry_run:
        say("--dry-run：所有门禁通过，未写入任何字节。")
        flush_log(logpath)
        return EXIT_OK

    # 首次写入前保存原始字节（undo 只存第一份，绝不覆盖）
    os.makedirs(UNDODIR, exist_ok=True)
    for rec in p["records"]:
        undo = os.path.join(UNDODIR, "%s.%s.bin" % (p["slug"], rec))
        if not os.path.exists(undo):
            with open(undo, "wb") as fh:
                fh.write(live[rec])
            say("undo      %s （首次生成的原始字节）" % undo)
        else:
            say("undo      %s 已存在，保留最早那份" % undo)
        pre = os.path.join(UNDODIR, "pre_%s_%s.%s.bin" % (p["slug"], _stamp(), rec))
        with open(pre, "wb") as fh:
            fh.write(live[rec])

    if not args.yes:
        ans = input("确认写入？输入补丁名或 YES: ").strip()
        if ans not in ("YES", "yes", p["name"], p["slug"]):
            say("已取消")
            flush_log(logpath)
            return EXIT_PATCH

    ok_all = True
    for rec in p["records"]:
        say("")
        say("写入      %s …" % rec)
        try:
            cleared = write_var(p["guid"], rec, target[rec])
        except RuntimeError as e:
            say("   失败: %s" % e)
            if "固件拒绝" in str(e):
                flush_log(logpath)
                die(EXIT_CHANNEL_DENIED,
                    "通道被拦：固件不接受普通 SetVariable 写这个变量。"
                    "改用 docs/how-it-works.md 里的备选通道。")
            flush_log(logpath)
            die(EXIT_ENGINE, str(e))
        if cleared:
            say("   immutable 标志已清除")
        _a2, after = read_var(p["guid"], rec)

        if after == target[rec]:
            say("   校验: 与预期逐字节一致")
            continue

        # 允许固件顺带改写其他字节，但必须：目标字节到位 && 其余字节未被碰
        bad = [c["off"] for c in p["changes"] if after[c["off"]] != c["to"]]
        if bad:
            say("   校验: 目标字节没写进去 (%s)"
                % ", ".join("0x%03X" % b for b in bad))
            say("   用 `insyde-nvram restore %s` 回滚，或先完整关机再试" % p["slug"])
            ok_all = False
            continue
        extra = [i for i in range(min(len(after), len(live[rec])))
                 if after[i] != target[rec][i]]
        say("   校验: 目标字节到位，但固件另外改写了 %d 字节 (%s)"
            % (len(extra), ", ".join("0x%03X" % i for i in extra[:10])))
        say("   记录！这些字节不在补丁范围内，回滚文件仍然有效。")

    say("")
    if ok_all:
        say("完成。设置项由固件在开机时读取 —— 请**完全关机**（poweroff），")
        say("再开机才会生效。reboot 不算。")
        say("回滚: sudo insyde-nvram restore %s" % p["patch"])
    flush_log(logpath)
    return EXIT_OK if ok_all else EXIT_VERIFY


def cmd_restore(args):
    logpath = os.path.join(LOGDIR, "restore_%s.txt" % _stamp())
    gate_root()
    p = parse_patch(args.patch)
    if not p["ok"]:
        die(EXIT_PATCH, "补丁有问题: %s" % p["err"])
    say("回滚      %s" % p["name"])

    state, detail = detect_tpm_sealed_volumes()
    say("加密状态  %s（回滚只报告，不拦 —— 卷已经躺进恢复模式时，把 TPM 放回去才是修复）"
        % state)
    for d in detail:
        say("          " + d)

    restored = 0
    for rec in p["records"]:
        undo = os.path.join(UNDODIR, "%s.%s.bin" % (p["slug"], rec))
        if not os.path.exists(undo):
            say("   缺少 %s —— 没有这个 patch 的原始副本" % undo)
            continue
        orig = open(undo, "rb").read()
        try:
            _a, cur = read_var(p["guid"], rec)
        except RuntimeError as e:
            die(EXIT_ENGINE, str(e))
        if cur == orig:
            say("   %s 已经是原始字节，跳过" % rec)
            restored += 1
            continue
        if not args.yes:
            ans = input("写回 %s 的原始 %d 字节？输入 YES: " % (rec, len(orig))).strip()
            if ans != "YES":
                say("已取消")
                flush_log(logpath)
                return EXIT_PATCH
        try:
            write_var(p["guid"], rec, orig)
        except RuntimeError as e:
            flush_log(logpath)
            die(EXIT_CHANNEL_DENIED if "固件拒绝" in str(e) else EXIT_ENGINE, str(e))
        _a, after = read_var(p["guid"], rec)
        if after == orig:
            say("   %s 已恢复并校验一致" % rec)
            restored += 1
        else:
            say("   %s 恢复后仍不一致" % rec)
    say("")
    say("回滚完成 %d 个记录。完全关机后生效。" % restored)
    flush_log(logpath)
    return EXIT_OK


