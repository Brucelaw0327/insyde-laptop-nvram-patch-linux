# 环境探测
# ---------------------------------------------------------------------------

def secure_boot_state():
    try:
        _a, d = read_var("8BE4DF61-93CA-11D2-AA0D-00E098032B8C", "SecureBoot")
        return "开启" if d and d[0] else "关闭"
    except RuntimeError:
        return "未知"


def tpm_present():
    for p in ("/sys/class/tpm/tpm0", "/dev/tpm0", "/dev/tpmrm0"):
        if os.path.exists(p):
            return True
    try:
        out = subprocess.run(["lsmod"], capture_output=True, text=True, timeout=5).stdout
        return bool(re.search(r"^tpm_", out, re.M))
    except (OSError, subprocess.SubprocessError):
        return False


def discover_setup_stores():
    """找出名字像 Setup 的变量，按 GUID 归组。不预置任何 GUID。"""
    stores = {}
    if not os.path.isdir(EFIVARS):
        return stores
    for fn in os.listdir(EFIVARS):
        m = re.match(r"^(.+)-([0-9a-fA-F-]{36})$", fn)
        if not m:
            continue
        name, guid = m.group(1), m.group(2)
        stores.setdefault(guid.upper(), [])
        try:
            attrs, data = read_var(guid, name)
        except RuntimeError:
            continue
        stores[guid.upper()].append({"name": name, "size": len(data), "attrs": attrs})
    for guid in list(stores):
        stores[guid].sort(key=lambda x: x["name"])
    return stores


def detect_tpm_sealed_volumes():
    """返回 (state, detail_list)。state: 'none' | 'sealed' | 'unknown'。"""
    detail = []
    devs = []
    try:
        out = subprocess.run(
            ["lsblk", "-J", "-o", "NAME,PATH,TYPE,FSTYPE"],
            capture_output=True, text=True, timeout=10)
        if out.returncode != 0:
            return "unknown", ["lsblk 执行失败，无法枚举块设备"]
        tree = json.loads(out.stdout or "{}")
    except FileNotFoundError:
        return "unknown", ["系统里没有 lsblk，无法枚举块设备"]
    except (subprocess.SubprocessError, ValueError) as e:
        return "unknown", ["枚举块设备失败: %s" % e]

    def walk(nodes):
        for n in nodes or []:
            if (n.get("fstype") or "").lower() == "crypto_luks" and n.get("path"):
                devs.append(n["path"])
            walk(n.get("children"))

    walk(tree.get("blockdevices"))

    if not devs:
        return "none", ["没有 crypto_LUKS 卷"]

    if not _have("cryptsetup"):
        return "unknown", ["存在 LUKS 卷但没装 cryptsetup，无法判定是否绑了 TPM2"]

    state = "none"
    for d in devs:
        try:
            r = subprocess.run(["cryptsetup", "luksDump", "--dump-json-metadata", d],
                               capture_output=True, text=True, timeout=15)
        except (OSError, subprocess.SubprocessError) as e:
            detail.append("%s: 读取元数据失败 (%s)" % (d, e))
            state = "unknown"
            continue
        if r.returncode != 0:
            detail.append("%s: cryptsetup 返回 %d" % (d, r.returncode))
            state = "unknown"
            continue
        try:
            meta = json.loads(r.stdout)
        except ValueError:
            detail.append("%s: 元数据不是合法 JSON" % d)
            state = "unknown"
            continue
        tokens = meta.get("tokens") or {}
        tpm_tokens = [k for k, v in tokens.items()
                      if "tpm2" in str(tokens.get(k, {}).get("type", "")).lower()]
        if tpm_tokens:
            detail.append("%s: TPM2 密封 token %s —— 关闭/改动 fTPM 会导致无法自动解锁"
                          % (d, ",".join(tpm_tokens)))
            state = "sealed"
        else:
            detail.append("%s: 仅口令/keyfile，未绑 TPM2" % d)
    return state, detail


def _have(cmd):
    for p in os.environ.get("PATH", "/usr/bin:/bin:/usr/sbin:/sbin").split(":"):
        if os.path.exists(os.path.join(p, cmd)):
            return True
    return False


def hexdump(data, base=0, width=16):
    lines = []
    for off in range(0, len(data), width):
        chunk = data[off:off + width]
        hexpart = " ".join("%02x" % b for b in chunk)
        hexpart = hexpart[:23] + " " + hexpart[23:] if len(chunk) > 8 else hexpart
        asci = "".join(chr(b) if 32 <= b < 127 else "." for b in chunk)
        lines.append("%08x  %-49s |%s|" % (base + off, hexpart, asci))
    return "\n".join(lines)


