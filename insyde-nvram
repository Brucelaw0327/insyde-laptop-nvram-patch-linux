ACPI_TABLES = "/sys/firmware/acpi/tables"
DMI_ENTRIES = "/sys/firmware/dmi/entries"


def tpm_evidence():
    """收集固件层关于 TPM 的证据。只读，不需要 root。"""
    ev = {"nodes": [], "acpi": [], "smbios43": False,
          "driver": [], "dmesg": [], "notes": []}

    for p in ("/sys/class/tpm/tpm0", "/dev/tpm0", "/dev/tpmrm0"):
        if os.path.exists(p):
            ev["nodes"].append(p)

    for name in ("TPM2", "TCPA"):
        p = os.path.join(ACPI_TABLES, name)
        if os.path.exists(p):
            try:
                ev["acpi"].append("%s (%d B)" % (name, os.path.getsize(p)))
            except OSError:
                ev["acpi"].append(name)

    if os.path.isdir(DMI_ENTRIES):
        try:
            ev["smbios43"] = any(n.startswith("43-") for n in os.listdir(DMI_ENTRIES))
        except OSError:
            pass

    # 内核侧有没有驱动：决定「以后真开了 fTPM，系统能不能用上」
    base = "/lib/modules/%s/kernel/drivers/char/tpm" % os.uname().release
    if os.path.isdir(base):
        try:
            ev["driver"] = sorted(n for n in os.listdir(base) if "crb" in n or n.startswith("tpm_tis"))
        except OSError:
            pass
    if _have("modinfo"):
        try:
            r = subprocess.run(["modinfo", "tpm_crb"], capture_output=True, text=True, timeout=5)
            if r.returncode == 0 and "(builtin)" in r.stdout:
                ev["driver"].append("tpm_crb=builtin")
        except (OSError, subprocess.SubprocessError):
            pass

    try:
        r = subprocess.run(["dmesg"], capture_output=True, text=True, timeout=5)
        if r.returncode == 0:
            ev["dmesg"] = [l.strip() for l in r.stdout.splitlines()
                           if re.search(r"tpm|ftpm|crb", l, re.I)][:8]
        else:
            ev["notes"].append("dmesg 需要 root，内核日志已跳过")
    except (OSError, subprocess.SubprocessError):
        ev["notes"].append("dmesg 不可用，内核日志已跳过")
    return ev


def tpm_verdict(ev):
    """返回 (state, 说明行)。state: ON / FIRMWARE_ON_KERNEL_OFF / OFF。"""
    if ev["nodes"]:
        return "ON", ["设备节点存在: %s" % ", ".join(ev["nodes"])]
    if ev["acpi"]:
        return "FIRMWARE_ON_KERNEL_OFF", [
            "固件已经把 TPM 描述给系统（ACPI: %s），但没有出现设备节点" % ", ".join(ev["acpi"]),
            "这是「固件开着、系统没接上」，和「BIOS 里关着」是两回事，先查驱动而不是改 NVRAM",
        ]
    why = ["SMBIOS Type 43（TPM Device）: %s"
           % ("有" if ev["smbios43"] else "连这一条都没有")]
    why.append("ACPI 表里没有 TPM2 / TCPA")
    why.append("结论：固件根本没有向系统描述任何 TPM —— fTPM 在 setup 里是关的")
    return "OFF", why


def cmd_tpm(args):
    ev = tpm_evidence()
    state, why = tpm_verdict(ev)

    say("== 固件层证据 ==")
    say("  TPM 设备节点    %s" % (", ".join(ev["nodes"]) if ev["nodes"]
                                  else "无（/sys/class/tpm 为空）"))
    say("  ACPI 表         %s" % (", ".join(ev["acpi"]) if ev["acpi"] else "无 TPM2 / TCPA"))
    say("  SMBIOS Type 43  %s" % ("有" if ev["smbios43"] else "无"))
    say("  内核驱动        %s" % (", ".join(dict.fromkeys(ev["driver"]))
                                  if ev["driver"] else "没找到"))
    for l in ev["dmesg"]:
        say("  dmesg           %s" % l)
    for n in ev["notes"]:
        say("  备注            %s" % n)
    say("")
    say("== 判定 ==")
    for l in why:
