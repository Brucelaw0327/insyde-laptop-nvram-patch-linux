def _read_text(path):
    try:
        with open(path, "r", encoding="utf-8", errors="replace") as fh:
            return fh.read().strip()
    except OSError:
        return ""


def live_identity():
    """与 Windows 版 HKLM\\HARDWARE\\DESCRIPTION\\System\\BIOS 的三项对应。

    Windows                     Linux (/sys/class/dmi/id)
    BIOSVersion                 bios_version
    BaseBoardProduct            board_name
    SystemProductName           product_name
    """
    d = "/sys/class/dmi/id"
    return {
        "BIOS": _read_text(os.path.join(d, "bios_version")),
        "BOARD": _read_text(os.path.join(d, "board_name")),
        "MODEL": _read_text(os.path.join(d, "product_name")),
    }


def live_identity_extended():
    d = "/sys/class/dmi/id"
    return {
        "vendor": _read_text(os.path.join(d, "sys_vendor")),
        "model": _read_text(os.path.join(d, "product_name")),
        "sku": _read_text(os.path.join(d, "product_sku")),
        "board": _read_text(os.path.join(d, "board_name")),
        "bios_vendor": _read_text(os.path.join(d, "bios_vendor")),
        "bios_version": _read_text(os.path.join(d, "bios_version")),
        "bios_date": _read_text(os.path.join(d, "bios_date")),
    }


def read_machine_file():
    """machine.txt 只装身份，不装偏移。占位符 <...> 视为空。"""
    out = {"BIOS": None, "BOARD": None, "MODEL": None}
    if not os.path.exists(MACHINE):
        return out
    for line in open(MACHINE, "r", encoding="utf-8", errors="replace"):
        t = line.strip()
        if not t or t.startswith("#") or "=" not in t:
            continue
        k, v = t.split("=", 1)
        k = k.strip().upper()
        v = v.strip()
        v = re.sub(r"\s+#.*$", "", v).strip()
        if k in out:
            out[k] = None if re.match(r"^<.*>$", v) else v
    return out


def seed_machine_file():
    """只在文件完全不存在时生成（与 Windows 版一致：写引擎绝不生成配置）。"""
    if os.path.exists(MACHINE):
        return False
    ident = live_identity()
    if not all(ident.values()):
        return False
    lines = [
        "# machine.txt -- 记录/补丁构建时本机的身份。由 `insyde-nvram status` 首次运行时",
        "# 自动生成（仅当文件不存在）。写引擎只会读它，绝不生成或补全。",
        "#",
        "# Windows 版的对应关系：",
        "#   BIOS  = HKLM\\HARDWARE\\DESCRIPTION\\System\\BIOS\\BIOSVersion",
        "#   BOARD = ...\\BaseBoardProduct",
        "#   MODEL = ...\\SystemProductName",
        "",
        "BIOS=%s" % ident["BIOS"],
        "BOARD=%s" % ident["BOARD"],
        "MODEL=%s" % ident["MODEL"],
        "",
        "# 这个文件只做身份闸门。要改哪个字节，写在 patches/*.patch 里。",
    ]
    with open(MACHINE, "w", encoding="utf-8") as fh:
        fh.write("\n".join(lines) + "\n")
    return True


# ---------------------------------------------------------------------------
# 补丁文件解析（与 lib/patchfile.ps1 行为一致）
# ---------------------------------------------------------------------------

def read_kv_file(path):
    kv = {}
    if not path or not os.path.exists(path):
        return kv
    with open(path, "r", encoding="utf-8", errors="replace") as fh:
        for line in fh:
            t = line.strip()
            if not t or t.startswith("#") or t.startswith(";"):
                continue
            eq = t.find("=")
            if eq < 0:
                continue
            k = t[:eq].strip().upper()
            v = t[eq + 1:].strip()
            v = re.sub(r"\s+#.*$", "", v).strip()
            if not k:
                continue
            if k in kv:
                kv[k] = (kv[k] if isinstance(kv[k], list) else [kv[k]]) + [v]
            else:
                kv[k] = v
    return kv


def parse_hex(s):
    if s is None:
        return -1
    t = re.sub(r"^0[xX]", "", str(s).strip())
    if not re.match(r"^[0-9A-Fa-f]+$", t):
        return -1
    try:
        return int(t, 16)
    except ValueError:
        return -1


def patch_slug(patch):
    n = ""
    if patch.get("path"):
        n = os.path.splitext(os.path.basename(patch["path"]))[0]
    elif patch.get("name"):
        n = patch["name"]
    n = re.sub(r"[^A-Za-z0-9_.-]+", "_", n).strip("_")
    return (n or "default").lower()


def parse_patch(path):
    r = {"ok": False, "err": "", "name": "", "varstore": "", "guid": "",
         "records": [], "changes": [], "path": "", "slug": "", "size": None}
    if not path:
        r["err"] = "没有指定补丁文件"
        return r
    if not os.path.exists(path):
        r["err"] = "找不到补丁文件: %s" % path
        return r
    kv = read_kv_file(path)

    r["name"] = kv.get("NAME") or os.path.splitext(os.path.basename(path))[0]
    r["varstore"] = kv.get("VARSTORE") or ""
    r["path"] = os.path.realpath(path)
    r["slug"] = patch_slug(r)

    if not kv.get("GUID"):
        r["err"] = "缺少 GUID（变量存储的 GUID）"
        return r
    g = str(kv["GUID"]).strip().strip("{}")
    if not GUID_RE.match(g):
        r["err"] = "GUID 不是 xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx 形式: %s" % g
        return r
    r["guid"] = g.upper()

    if kv.get("RECORDS"):
        r["records"] = [x.strip() for x in str(kv["RECORDS"]).split(",") if x.strip()]
    elif kv.get("RECORD"):
        r["records"] = [str(kv["RECORD"]).strip()]
    if not r["records"]:
        r["err"] = '缺少 RECORDS（逗号分隔的记录名，例如 "Setup"）'
        return r

    if kv.get("SIZE") is not None:
        sz = parse_hex(kv["SIZE"])
        if sz <= 0:
            r["err"] = "SIZE 不是合法的十六进制长度: %s" % kv["SIZE"]
            return r
        r["size"] = sz

    changes = []
    if "CHANGE" in kv:
        if "OFFSET" in kv or "FROM" in kv or "TO" in kv:
            r["err"] = "OFFSET/FROM/TO 与 CHANGE 行只能选一种，不能混用"
            return r
        items = kv["CHANGE"] if isinstance(kv["CHANGE"], list) else [kv["CHANGE"]]
        for c in items:
            tk = [x for x in re.split(r"\s+", str(c).strip()) if x]
            if len(tk) != 3:
                r["err"] = 'CHANGE 需要 "OFFSET FROM TO" 三个值，实际: %s' % c
                return r
            o, f, t = parse_hex(tk[0]), parse_hex(tk[1]), parse_hex(tk[2])
            if min(o, f, t) < 0:
                r["err"] = "CHANGE 里有非十六进制值: %s" % c
                return r
            changes.append({"off": o, "from": f, "to": t})
    else:
        o = parse_hex(kv.get("OFFSET"))
        f = parse_hex(kv.get("FROM"))
        t = parse_hex(kv.get("TO"))
        if min(o, f, t) < 0:
            r["err"] = "OFFSET / FROM / TO 三者都要有（十六进制），或改用 CHANGE 行"
            return r
        changes.append({"off": o, "from": f, "to": t})

    seen = {}
    for c in changes:
        if c["off"] in seen:
            r["err"] = "偏移 0x%X 出现了不止一次" % c["off"]
            return r
        seen[c["off"]] = True
        if c["from"] > 0xFF or c["to"] > 0xFF:
            r["err"] = ("偏移 0x%X: FROM/TO 必须是单个字节 (0x00-0xFF)，实际 0x%X / 0x%X"
                        % (c["off"], c["from"], c["to"]))
            return r
        if c["from"] == c["to"]:
            r["err"] = ("偏移 0x%X: FROM 与 TO 都是 0x%02X —— 什么也没改"
                        % (c["off"], c["from"]))
            return r

    r["changes"] = sorted(changes, key=lambda x: x["off"])
    r["ok"] = True
    return r


# ---------------------------------------------------------------------------
# efivarfs 后端
# ---------------------------------------------------------------------------

def efivar_path(guid, name):
    return os.path.join(EFIVARS, "%s-%s" % (name, guid.lower()))


class ChannelDenied(RuntimeError):
    """固件/环境拒绝写入 —— 与「代码写错了」区分开，对应退出码 13。"""


def read_var(guid, name):
    """返回 (attrs, data)。data 不含 4 字节属性头。"""
    path = efivar_path(guid, name)
    try:
        with open(path, "rb") as fh:
            raw = fh.read()
    except OSError as e:
        raise RuntimeError("读取 %s 失败: %s" % (path, e.strerror))
    if len(raw) < 4:
        raise RuntimeError("%s 长度异常 (%d 字节)" % (path, len(raw)))
    return int.from_bytes(raw[:4], "little"), raw[4:]


def _get_inode_flags(path):
    fd = os.open(path, os.O_RDONLY)
    try:
        return int.from_bytes(fcntl.ioctl(fd, FS_IOC_GETFLAGS, b"\x00" * 4), "little")
    finally:
        os.close(fd)


def _set_inode_flags(path, flags):
    fd = os.open(path, os.O_RDONLY)
    try:
        fcntl.ioctl(fd, FS_IOC_SETFLAGS, flags.to_bytes(4, "little"))
    finally:
        os.close(fd)


def clear_immutable(path):
    """efivarfs 会把变量标成 inode immutable，写之前必须清掉（等效 chattr -i）。"""
    try:
        flags = _get_inode_flags(path)
    except OSError as e:
        raise RuntimeError("读 inode 标志失败: %s" % e.strerror)
    if not flags & FS_IMMUTABLE_FL:
        return False
    try:
        _set_inode_flags(path, flags & ~FS_IMMUTABLE_FL)
    except OSError as e:
        raise RuntimeError(
            "清除 immutable 标志失败（需要 CAP_LINUX_IMMUTABLE，且不能在容器里跑）: %s"
            % e.strerror)
    return True


def write_var(guid, name, data):
    """整块写入变量数据。成功返回是否清过 immutable，失败抛 ChannelDenied/RuntimeError。"""
    path = efivar_path(guid, name)
    if not os.path.exists(path):
        raise RuntimeError("变量不存在: %s" % path)
    attrs, _ = read_var(guid, name)
    if attrs & 0x60:  # AUTHENTICATED_WRITE_ACCESS / TIME_BASED_AUTHENTICATED
        raise ChannelDenied(
            "变量属性 0x%08x 带认证写入位，OS 侧不可能写入成功" % attrs)
    cleared = clear_immutable(path)
    try:
        fd = os.open(path, os.O_WRONLY)
    except OSError as e:
        if e.errno in (errno.EPERM, errno.EACCES):
            raise ChannelDenied(
                "打开失败 (%s)。两种可能：(1) 在容器/沙箱里跑，efivarfs 写入被外层拦住；"
                "(2) 固件拒绝普通 SetVariable。在真实 root shell 里跑 "
                "`insyde-nvram probe --scan` 就能把两者分开。" % e.strerror)
        raise ChannelDenied(classify_efi_error(e))
    try:
        n = os.write(fd, data)
        if n != len(data):
            raise RuntimeError("只写入 %d / %d 字节" % (n, len(data)))
    except OSError as e:
        raise ChannelDenied(classify_efi_error(e))
    finally:
        os.close(fd)
    return cleared


def classify_efi_error(e):
    """把 errno 翻译成「固件到底说了什么」。

    efivarfs 的写入错误码是内核把 EFI_STATUS 映射出来的结果，看着像 Linux 权限
    问题，其实全是固件在回答。EOFS 是最容易被误读的一个：
        EFI_WRITE_PROTECTED  ->  -EROFS   （"Read-only file system"，与文件系统无关）
    """
    code = errno.errorcode.get(e.errno, str(e.errno))
    if e.errno == errno.EROFS:
        return ("固件返回 EFI_WRITE_PROTECTED（内核映射成 EROFS=%s）：这个变量被固件"
                "写保护。报错文字像「只读文件系统」，其实跟文件系统没关系 —— 普通 "
                "SetVariable 在这条变量上被固件驳回，只有走 SMI 服务的通道"
                "（H2OUVE）能改。见 README 第 9 节。" % code)
    if e.errno in (errno.EIO,):
        return ("固件返回 EFI 错误（ERRNO=%s，多半是 EFI_SECURITY_VIOLATION）："
                "SetVariable 被拒。" % code)
    if e.errno in (errno.EPERM, errno.EACCES):
        return ("内核/固件拒绝写入（%s）。若 immutable 已清除仍失败，说明固件拦了"
                "这条变量。" % code)
    if e.errno == errno.EINVAL:
        return ("数据不被接受（%s）：长度、属性或内容不合固件要求。" % code)
    if e.errno == errno.EOPNOTSUPP:
        return ("固件没有声明 SET_VARIABLE 运行时能力（%s）：efivarfs 整条写路径"
                "在这台机器上不可用。" % code)
    if e.errno == errno.ENOSPC:
        return "固件报告变量空间不足（%s）。" % code
    return "写入失败（%s %s）。" % (code, e.strerror)


