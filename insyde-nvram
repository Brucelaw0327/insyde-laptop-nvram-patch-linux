# 环境探测
# ---------------------------------------------------------------------------

def secure_boot_state():
    try:
        _a, d = read_var("8BE4DF61-93CA-11D2-AA0D-00E098032B8C", "SecureBoot")
        return "开启" if d and d[0] else "关闭"
    except RuntimeError:
        return "未知"


def tpm_present():
    for p in ("/sys/class/tpm/tpm0", "/dev/tpm0", "/dev/tpmrm0"):
        if os.path.exists(p):
            return True
    try:
        out = subprocess.run(["lsmod"], capture_output=True, text=True, timeout=5).stdout
        return bool(re.search(r"^tpm_", out, re.M))
    except (OSError, subprocess.SubprocessError):
        return False


def discover_setup_stores():
    """找出名字像 Setup 的变量，按 GUID 归组。不预置任何 GUID。"""
    stores = {}
    if not os.path.isdir(EFIVARS):
        return stores
    for fn in os.listdir(EFIVARS):
        m = re.match(r"^(.+)-([0-9a-fA-F-]{36})$", fn)
        if not m:
            continue
        name, guid = m.group(1), m.group(2)
        stores.setdefault(guid.upper(), [])
        try:
            attrs, data = read_var(guid, name)
        except RuntimeError:
            continue
        stores[guid.upper()].append({"name": name, "size": len(data), "attrs": attrs})
    for guid in list(stores):
        stores[guid].sort(key=lambda x: x["name"])
    return stores


def detect_tpm_sealed_volumes():
    """返回 (state, detail_list)。state: 'none' | 'sealed' | 'unknown'。"""
    detail = []
    devs = []
    try:
        out = subprocess.run(
            ["lsblk", "-J", "-o", "NAME,PATH,TYPE,FSTYPE"],
            capture_output=True, text=True, timeout=10)
        if out.returncode != 0:
            return "unknown", ["lsblk 执行失败，无法枚举块设备"]
        tree = json.loads(out.stdout or "{}")
    except FileNotFoundError:
        return "unknown", ["系统里没有 lsblk，无法枚举块设备"]
    except (subprocess.SubprocessError, ValueError) as e:
        return "unknown", ["枚举块设备失败: %s" % e]

    def walk(nodes):
        for n in nodes or []:
            if (n.get("fstype") or "").lower() == "crypto_luks" and n.get("path"):
                devs.append(n["path"])
            walk(n.get("children"))

    walk(tree.get("blockdevices"))

    if not devs:
        return "none", ["没有 crypto_LUKS 卷"]

    if not _have("cryptsetup"):
        return "unknown", ["存在 LUKS 卷但没装 cryptsetup，无法判定是否绑了 TPM2"]

    state = "none"
    for d in devs:
        try:
            r = subprocess.run(["cryptsetup", "luksDump", "--dump-json-metadata", d],
                               capture_output=True, text=True, timeout=15)
        except (OSError, subprocess.SubprocessError) as e:
            detail.append("%s: 读取元数据失败 (%s)" % (d, e))
            state = "unknown"
            continue
        if r.returncode != 0:
            detail.append("%s: cryptsetup 返回 %d" % (d, r.returncode))
            state = "unknown"
            continue
        try:
            meta = json.loads(r.stdout)
        except ValueError:
            detail.append("%s: 元数据不是合法 JSON" % d)
            state = "unknown"
            continue
        tokens = meta.get("tokens") or {}
        tpm_tokens = [k for k, v in tokens.items()
                      if "tpm2" in str(tokens.get(k, {}).get("type", "")).lower()]
        if tpm_tokens:
            detail.append("%s: TPM2 密封 token %s —— 关闭/改动 fTPM 会导致无法自动解锁"
                          % (d, ",".join(tpm_tokens)))
            state = "sealed"
        else:
            detail.append("%s: 仅口令/keyfile，未绑 TPM2" % d)
    return state, detail


def _have(cmd):
    for p in os.environ.get("PATH", "/usr/bin:/bin:/usr/sbin:/sbin").split(":"):
        if os.path.exists(os.path.join(p, cmd)):
            return True
    return False


def hexdump(data, base=0, width=16):
    lines = []
    for off in range(0, len(data), width):
        chunk = data[off:off + width]
        hexpart = " ".join("%02x" % b for b in chunk)
        hexpart = hexpart[:23] + " " + hexpart[23:] if len(chunk) > 8 else hexpart
        asci = "".join(chr(b) if 32 <= b < 127 else "." for b in chunk)
        lines.append("%08x  %-49s |%s|" % (base + off, hexpart, asci))
    return "\n".join(lines)


# ---------------------------------------------------------------------------
# 门禁
# ---------------------------------------------------------------------------

def gate_root():
    if os.geteuid() != 0:
        die(EXIT_NOT_ROOT, "没有 root 权限 —— 用 sudo 运行，或 ./run.sh 选项 4")


def gate_machine(force):
    ident = read_machine_file()
    if not any(ident.values()):
        if force:
            say("门禁[身份] 缺少 machine.txt —— --force 跳过（危险）")
            return
        die(EXIT_NO_MACHINE,
            "缺少 machine.txt。先运行 `insyde-nvram status` 生成基线，"
            "写引擎不会自己编一个。")
    live = live_identity()
    bad = []
    for k in ("BIOS", "BOARD", "MODEL"):
        want, got = ident.get(k), live.get(k)
        if want and want != got:
            bad.append("   %-5s machine.txt=%-24s 本机=%s" % (k, want, got))
        elif not want:
            bad.append("   %-5s machine.txt 里是空占位符" % k)
    if bad:
        say("门禁[身份] 不匹配：")
        for b in bad:
            say(b)
        if force:
            say("   --force 已跳过身份门禁（危险）")
            return
        die(EXIT_IDENTITY, "身份门禁拒绝执行。换机器/换 BIOS 后请重新生成 machine.txt。")
    say("门禁[身份] 通过  BIOS=%s BOARD=%s MODEL=%s"
        % (live["BIOS"], live["BOARD"], live["MODEL"]))


def gate_encryption(force):
    state, detail = detect_tpm_sealed_volumes()
    for d in detail:
        say("   " + d)
    if state == "sealed":
        if force:
            say("门禁[加密] 有 TPM2 密封的卷 —— --force 跳过（危险）")
            return
        die(EXIT_ENC_LOCKED,
            "门禁[加密] 存在把密钥密封进 TPM 的加密卷。先解除 TPM2 绑定"
            "（systemd-cryptenroll --tpm2-device=none 或 luksRemoveKey 对应 token），"
            "否则本次改动会让那个卷下次开机进不了系统。")
    if state == "unknown":
        if force:
            say("门禁[加密] 无法判定 —— --force 跳过（危险）")
            return
        die(EXIT_ENC_UNKNOWN, "门禁[加密] 无法判定加密状态，需要人工确认后再来。")
    say("门禁[加密] 通过（没有 TPM 密封的卷）")


def gate_layout(patch, live_sizes, force):
    undo = os.path.join(UNDODIR, patch["slug"] + ".bin")
    problems = []
    if patch.get("size"):
        for name, size in live_sizes.items():
            if size != patch["size"]:
                problems.append("   %s 实际 %d 字节，补丁声明 %d 字节"
                                % (name, size, patch["size"]))
    if os.path.exists(undo):
        want = os.path.getsize(undo)
        for name, size in live_sizes.items():
            if size != want:
                problems.append("   %s 实际 %d 字节，首次写入时的基线 %d 字节"
                                % (name, size, want))
    if problems:
        say("门禁[布局] 不匹配：")
        for p in problems:
            say(p)
        if force:
            say("   --force 已跳过布局门禁（危险）")
            return
        die(EXIT_LAYOUT, "门禁[布局] 变量大小/布局变了（刷过 BIOS？清过 CMOS？）—— 重新定位偏移。")
    say("门禁[布局] 通过（%s）"
        % ", ".join("%s=%dB" % kv for kv in live_sizes.items()))


def gate_values(patch, live, force):
    """live: {record: bytes}。返回 [(record, off, cur)]，不匹配则退出。"""
    hits = []
    bad = []
    for rec in patch["records"]:
        data = live.get(rec)
        if data is None:
            bad.append("   %s 读不到" % rec)
            continue
        for c in patch["changes"]:
            if c["off"] >= len(data):
                bad.append("   %s 偏移 0x%X 超出变量长度 %d" % (rec, c["off"], len(data)))
                continue
            cur = data[c["off"]]
            hits.append((rec, c["off"], cur))
            if cur != c["from"]:
                if cur == c["to"]:
                    bad.append("   %s 偏移 0x%X 已经是目标值 0x%02X（这条改动已生效或无需改动）"
                               % (rec, c["off"], cur))
                else:
                    bad.append("   %s 偏移 0x%X 当前 0x%02X，补丁要求 FROM=0x%02X"
                               % (rec, c["off"], cur, c["from"]))
    if bad:
        say("门禁[取值] 不匹配：")
        for b in bad:
            say(b)
        if force:
            say("   --force 已跳过取值门禁（危险：将按补丁写死值，不再核对旧值）")
            return hits
        die(EXIT_LAYOUT, "门禁[取值] 拒绝盲写。偏移不是你以为的那个，或者已经改过了。")
    say("门禁[取值] 通过（%d 处改动全部对上旧值）" % len(patch["changes"]))
    return hits


