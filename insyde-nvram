    if args.baseline:
        say("")
        say("== 打基线快照 ==")
        rc = cmd_dump(argparse.Namespace(label="ftpm-before",
                                         guid=args.guid, record=None))
        if rc != EXIT_OK:
            return rc
        say("")
        say("接下来：重启进 BIOS，把 fTPM / Security Device / AMD fTPM switch 打开并保存，")
        say("再回到系统执行：")
        say("    sudo ./insyde-nvram tpm --after %s --out patches/ftpm-on.patch"
            % (LAST_SNAPDIR or "<上面的快照目录>"))
        say("只改这一项，别的什么都别动 —— 否则 diff 出的一堆字节分不清哪个是 fTPM。")

    elif args.after:
