def _fstype(path):
    try:
        out = subprocess.run(["findmnt", "-no", "FSTYPE,OPTIONS", "--target", path],
                             capture_output=True, text=True, timeout=5).stdout.strip()
        if out:
            return out.replace("\t", " ")
    except (OSError, subprocess.SubprocessError):
        pass
    try:
        with open("/proc/self/mounts", "r", encoding="utf-8", errors="replace") as fh:
            for line in fh:
                parts = line.split()
                if len(parts) >= 4 and parts[1] == path.rstrip("/"):
                    return "%s %s" % (parts[2], parts[3])
    except OSError:
        pass
    return ""


def _attr_words(attrs):
    w = []
    if attrs & 1:
        w.append("NV")
    if attrs & 2:
        w.append("BS")
    if attrs & 4:
        w.append("RT")
    if attrs & 8:
        w.append("HS")
    if attrs & 0x10:
        w.append("AUTH")
    if attrs & 0x20:
        w.append("AUTH-TIME")
    return "|".join(w) or "-"


def _stamp():
    return time.strftime("%Y%m%d-%H%M%S")


