# CLI
# ---------------------------------------------------------------------------

def build_parser():
    ap = argparse.ArgumentParser(
        prog="insyde-nvram",
        description="Insyde H2O 笔记本 NVRAM 补丁工具（Linux / efivarfs 版）",
        epilog="先读 docs/how-it-works.md 和 DISCLAIMER.md。改动固件 NVRAM 可能变砖。")
    ap.add_argument("--version", action="version", version="insyde-nvram " + VERSION)
    sub = ap.add_subparsers(dest="cmd", required=True)

    s = sub.add_parser("status", help="只读状态探针（首次运行会生成 machine.txt）")
    s.add_argument("--json", action="store_true", help="机器可读输出（未实现时忽略）")
    s.set_defaults(func=cmd_status)

    s = sub.add_parser("list", help="列出 efivarfs 里的 Setup 类变量")
    s.add_argument("--guid")
    s.add_argument("--all", action="store_true", help="列出全部变量（含引导项/证书）")
    s.set_defaults(func=cmd_list)

    s = sub.add_parser("dump", help="打一份快照到 snapshots/")
    s.add_argument("--guid")
    s.add_argument("--record", action="append", help="只导出指定记录（可多次）")
    s.add_argument("--label", default="", help="快照标签，例如 before / after-biossave")
    s.set_defaults(func=cmd_dump)

    s = sub.add_parser("show", help="十六进制查看快照")
    s.add_argument("path")
    s.add_argument("--start", type=lambda x: int(x, 0), default=0)
    s.add_argument("--end", type=lambda x: int(x, 0), default=None)
    s.set_defaults(func=cmd_show)

    s = sub.add_parser("diff", help="比较两份快照，生成候选补丁（差分定位法）")
    s.add_argument("old")
    s.add_argument("new")
    s.add_argument("--out", help="把差异写成候选 .patch")
    s.add_argument("--guid", help="候选补丁里要填的 GUID")
    s.add_argument("--name", help="候选补丁的 NAME")
    s.set_defaults(func=cmd_diff)

    s = sub.add_parser("check", help="只读：显示补丁会动哪个字节、当前值是多少")
    s.add_argument("patch")
    s.set_defaults(func=cmd_check)

    s = sub.add_parser("apply", help="应用补丁（会修改 NVRAM）")
    s.add_argument("patch")
    s.add_argument("--dry-run", action="store_true", help="跑完所有门禁但不写入")
    s.add_argument("--yes", action="store_true", help="跳过交互确认")
    s.add_argument("--force", action="store_true", help="一次性跳过所有门禁（危险）")
    s.set_defaults(func=cmd_apply)

    s = sub.add_parser("restore", help="按 undo 副本逐字节回滚")
    s.add_argument("patch")
    s.add_argument("--yes", action="store_true")
    s.set_defaults(func=cmd_restore)

    s = sub.add_parser("probe", help="写通道探针：原样写回，不改任何值")
    s.add_argument("--record", default="Setup")
    s.add_argument("--guid")
    s.add_argument("--yes", action="store_true")
    s.set_defaults(func=cmd_probe)

    return ap


def main(argv):
    ap = build_parser()
    args = ap.parse_args(argv)
    return args.func(args)


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv[1:]))
    except KeyboardInterrupt:
        print("\n中断")
        sys.exit(130)
