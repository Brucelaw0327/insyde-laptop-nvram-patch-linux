    return EXIT_OK


def _tpm_after(args):
    """对比基线快照与当前 live，并给出「fTPM 是否真的开了」的判定。"""
    baseline = _load_snapshot(args.after)
    meta_path = os.path.join(args.after if os.path.isdir(args.after) else "",
                             "meta.json")
    guid = args.guid.upper() if args.guid else None
    if not guid and os.path.isfile(meta_path):
        try:
            guid = json.load(open(meta_path, encoding="utf-8")).get("guid", "").upper() or None
        except (OSError, ValueError):
            pass
    if not guid:
        die(EXIT_PATCH, "读不出基线的 GUID，用 --guid 指定")

    say("")
    say("== 固件层复查 ==")
    ev = tpm_evidence()
    state, why = tpm_verdict(ev)
    for l in why:
        say("  " + l)

    say("")
    say("== 字节差异（基线 -> 当前） ==")
    total = 0
    per_record = {}
    for name in sorted(baseline):
        try:
            _a, live = read_var(guid, name)
        except RuntimeError as e:
            say("  %-10s 读不到: %s" % (name, e))
            continue
        old = baseline[name]
        if len(old) != len(live):
            say("  %-10s 长度变了 %d -> %d（布局变化，偏移不可沿用）"
                % (name, len(old), len(live)))
        diffs = [(i, old[i], live[i]) for i in range(min(len(old), len(live)))
                 if old[i] != live[i]]
        if not diffs:
            say("  %-10s 字节完全相同" % name)
            continue
        say("  %-10s %d 处" % (name, len(diffs)))
        for off, x, y in diffs:
            say("     0x%03x  %02x -> %02x" % (off, x, y))
        per_record[name] = diffs
        total += len(diffs)

    say("")
    if state == "ON":
        say("VERDICT: fTPM 已经开了 —— 实验成功")
    elif total == 0:
        say("VERDICT: 什么都没变。要么 BIOS 里那一步没保存，要么这一项不落在")
        say("         这个变量里（换 GUID 再试，见 list 的输出）")
    else:
        say("VERDICT: 字节变了，但 fTPM 还没起来 —— 别急着下结论：")
        say("         AMD 上 fTPM 首次启用通常要完全断电（拔电/长按电源 10s）冷启动才会生效")

    if total and args.out:
        header = [
            "# 由 `insyde-nvram tpm --after` 生成",
            "# 前提：基线之后只动过 BIOS 里 fTPM 那一项。若不成立，这些字节不可信。",
            "# 期望效果：应用后 ACPI 出现 TPM2 表、出现 /dev/tpm0",
        ]
        outs = emit_candidate_patches(args.out, "ftpm-on", guid, per_record, header)
        say("")
        if len(outs) == 1:
            say("候选补丁: %s" % outs[0])
        else:
            say("差异落在 %d 个记录，已拆成 %d 份补丁:" % (len(outs), len(outs)))
            for p in outs:
                say("   %s" % p)
        say("  它只是「这些字节变了」，不等于「这些字节就是 fTPM」。")
        say("  想验证：把补丁改回去（用反方向 apply）再进 BIOS 开一次，看差异是否仍是这几处。")
    return EXIT_OK


def _channel_ok():
    st = _load_channel_state()
    if not st:
        return True          # 没测过，不做断言
    recs = st.get("records") or {}
    return any(v == "WRITE_OK" for v in recs.values())


def cmd_probe(args):
    """只把原字节写回，用于判定固件是否允许 OS 侧 SetVariable。"""
    gate_root()
    if args.scan:
        return probe_scan(args)
    stores = discover_setup_stores()
    guid = args.guid.upper() if args.guid else None
    if not guid:
        cand = [g for g, v in stores.items() if any(r["name"] == args.record for r in v)]
        if len(cand) != 1:
            die(EXIT_PATCH, "无法唯一确定 GUID，用 --guid 指定")
        guid = cand[0]

    attrs, data = read_var(guid, args.record)
    say("探针目标  %s / %s" % (guid, args.record))
    say("数据长度  %d 字节  attrs=0x%08x (%s)" % (len(data), attrs, _attr_words(attrs)))
    say("")
    say("这个命令做且只做一件事：把当前字节原样写回，然后回读比对。")
    say("它不会改动任何一个值。失败只说明通道不可用，不会造成副作用。")
    if not args.yes:
        ans = input("\n输入 PROBE 继续: ").strip()
        if ans != "PROBE":
            say("已取消")
            return EXIT_PATCH
    try:
        cleared = write_var(guid, args.record, data)
    except RuntimeError as e:
        say("")
        say(str(e))
        say("")
        say("VERDICT: WRITE_BLOCKED")
        _save_channel_state({args.record: "WRITE_BLOCKED"})
        return EXIT_CHANNEL_DENIED
    say("immutable 标志: %s" % ("已清除" if cleared else "无需清除"))
    _a2, after = read_var(guid, args.record)
    if after == data:
        say("回读比对: 完全一致")
        say("")
        say("VERDICT: WRITE_OK —— efivarfs 通道可用，可以应用补丁")
        _save_channel_state({args.record: "WRITE_OK"})
        return EXIT_OK
    diff = [i for i in range(min(len(data), len(after))) if data[i] != after[i]]
    say("回读比对: 不一致，%d 处" % len(diff))
    for i in diff[:20]:
        say("   0x%03X  %02x -> %02x" % (i, data[i], after[i]))
    say("")
    say("VERDICT: WRITE_MUTATED —— 写入被接受但固件改了字节，不要在这个通道上做真实改动")
    _save_channel_state({args.record: "WRITE_MUTATED"})
    return EXIT_CHANNEL_MUTATED


def _channel_state_path():
    return os.path.join(LOGDIR, "channel.json")


def _save_channel_state(results):
    try:
        os.makedirs(LOGDIR, exist_ok=True)
        with open(_channel_state_path(), "w", encoding="utf-8") as fh:
            json.dump({"time": time.strftime("%Y-%m-%d %H:%M:%S"), "records": results},
                      fh, indent=2, ensure_ascii=False)
    except OSError:
        pass


def _load_channel_state():
    p = _channel_state_path()
    if not os.path.exists(p):
        return None
    try:
        with open(p, "r", encoding="utf-8") as fh:
            return json.load(fh)
    except (OSError, ValueError):
        return None


def _scratch_var_test():
    """造一个一次性变量再删掉，判断「普通 SetVariable 通不通」。

    这一条把两种完全不同的失败区分开：
      * 连临时变量都建不出来 → 整条 efivarfs 写路径被封（固件没声明 SET_VARIABLE）
      * 临时变量没问题、只有 Setup 不行 → 固件只写保护了 Setup，别的存储还能改
    """
    guid = "1F0E7C3A-9B2D-4C58-8A41-6D2E5B90317C"
    name = "InsydeNvramProbe"
    path = efivar_path(guid, name)
    payload = b"insyde-nvram probe"
    try:
        fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o644)
        try:
            os.write(fd, (0x07).to_bytes(4, "little") + payload)
        finally:
            os.close(fd)
    except OSError as e:
        return False, classify_efi_error(e)
    try:
        raw = open(path, "rb").read()
    except OSError as e:
        return False, "读回失败: %s" % e.strerror
    ok = raw[4:] == payload
    try:
        os.unlink(path)
    except OSError:
        pass
    return ok, ("创建/读回/删除全部成功" if ok else "写进去了但读回不一致")


def _short_reason(msg, limit=72):
    """把长解释压成一行，保留最像原因的那半句。"""
    msg = str(msg).strip().replace("\n", " ")
    cut = msg.find("。")
    if 0 < cut <= limit:
        return msg[:cut]
    return msg[:limit] + ("…" if len(msg) > limit else "")


def probe_scan(args):
    """扫一遍：普通 SetVariable 通不通 + 每个 Setup 类记录通不通。"""
    say("通道扫描 —— 每一项都只写回原字节（或一个一次性临时变量），不改任何设置")
    say("=" * 64)
    if not args.yes:
        ans = input("输入 SCAN 继续: ").strip()
        if ans != "SCAN":
            say("已取消")
            return EXIT_PATCH

    say("")
    say("[1] 普通 SetVariable（建一个 InsydeNvramProbe 临时变量，验完即删）")
    ok, msg = _scratch_var_test()
    say("    %s  %s" % ("通过" if ok else "失败", msg))
    general_ok = ok
    say("")

    say("[2] 各个 Setup 类变量（写回原字节）")
    stores = discover_setup_stores()
    targets = []
    for guid, recs in sorted(stores.items()):
        for r in recs:
            if r["name"] in SETUP_NAMES:
                targets.append((guid, r))
    if not targets:
        say("    没找到 Setup 类变量")
    results = {}
    for guid, r in targets:
        name, attrs = r["name"], r["attrs"]
        label = "%s / %s" % (guid, name)
        if attrs & 0x60:
            say("    %-52s 跳过（attrs=0x%02x 带认证位，OS 侧写不了）" % (label, attrs))
            results[name] = "SKIP_AUTH"
            continue
        try:
            _a, data = read_var(guid, name)
            write_var(guid, name, data)
            _b, after = read_var(guid, name)
        except RuntimeError as e:
            say("    %-52s 拒绝  %s" % (label, _short_reason(e)))
            results[name] = "WRITE_BLOCKED"
            continue
        if after == data:
            say("    %-52s 可用（回读一致）" % label)
            results[name] = "WRITE_OK"
        else:
            say("    %-52s 写入被接受但字节被改（%d 处）"
                % (label, sum(1 for i in range(min(len(data), len(after)))
                              if data[i] != after[i])))
            results[name] = "WRITE_MUTATED"

    _save_channel_state(results)
    say("")
    say("=" * 64)
    if general_ok and any(v == "WRITE_OK" for v in results.values()):
        say("结论：efivarfs 通道整体可用，标记为「可用」的记录能直接 apply。")
    elif general_ok:
        say("结论：普通 SetVariable 可用，但 Setup 类变量全部被写保护 ——")
        say("      这不是权限或内核问题，是固件在拒绝。走 README 第 9 节的备选通道。")
    else:
        say("结论：连临时变量都写不进去，整条 efivarfs 写路径在这台机器上不可用 ——")
        say("      可能是固件没声明 SET_VARIABLE 运行时能力。走 README 第 9 节。")
    say("结果已存入 logs/channel.json（status 会显示）")
    return EXIT_CHANNEL_DENIED if not any(v.startswith("WRITE_OK") for v in results.values()) \
        else EXIT_OK


def build_target(patch, live):
    """目标数据 = 实机当前字节 + 恰好这些改动。同时做合理性检查。

    返回 {record: bytes}；不满足「目标字节确实是 TO」时抛 RuntimeError。
    """
    target = {}
    for rec, data in live.items():
        buf = bytearray(data)
        for c in patch["changes"]:
            buf[c["off"]] = c["to"]
        target[rec] = bytes(buf)
        for c in patch["changes"]:
            if buf[c["off"]] != c["to"]:
                raise RuntimeError("合理性检查失败: %s 0x%03X 未变成 0x%02X"
                                   % (rec, c["off"], c["to"]))
    return target


def cmd_export(args):
    """离线导出目标字节 + 改动表，给 RU.EFI / H2OUVE 之类的手工通道用。"""
    p = parse_patch(args.patch)
    if not p["ok"]:
        die(EXIT_PATCH, "补丁有问题: %s" % p["err"])
    live = {}
    for rec in p["records"]:
        try:
            _a, live[rec] = read_var(p["guid"], rec)
        except RuntimeError as e:
            die(EXIT_ENGINE, str(e))

    # 导出的目标值是「实机当前字节 + 改动」算出来的，所以旧值必须对得上，
    # 否则导出的东西就是基于错误前提的产物 —— 手工通道里没人会替你再核一遍。
    bad = []
    for rec in p["records"]:
        for c in p["changes"]:
            cur = live[rec][c["off"]] if c["off"] < len(live[rec]) else None
            if cur != c["from"]:
                bad.append("   %s 0x%03X 当前 %s，补丁要求 FROM 0x%02X"
                           % (rec, c["off"],
                              "越界" if cur is None else "0x%02X" % cur, c["from"]))
    if bad:
        say("取值对不上，不导出：")
        for b in bad:
            say(b)
        die(EXIT_LAYOUT, "先确认偏移和旧值（`insyde-nvram check`），别把错的带进手工通道。")

    try:
        target = build_target(p, live)
    except RuntimeError as e:
        die(EXIT_SANITY, str(e))

    outdir = args.out or os.path.join(HERE, "export", p["slug"])
    os.makedirs(outdir, exist_ok=True)
    lines = []
    for rec in p["records"]:
        fn = os.path.join(outdir, "target.%s.bin" % rec)
        with open(fn, "wb") as fh:
            fh.write(target[rec])
        say("目标字节  %s  (%d 字节)" % (fn, len(target[rec])))

    lines.append("# %s" % p["name"])
    lines.append("# GUID    %s" % p["guid"])
    lines.append("# 记录    %s" % ", ".join(p["records"]))
    lines.append("# 生成于  %s" % time.strftime("%Y-%m-%d %H:%M:%S"))
    lines.append("")
    lines.append("# 手动写入时，把下面每一行的当前值改成目标值（偏移不含 efivarfs 属性头）")
    for rec in p["records"]:
        lines.append("")
        lines.append("[%s]" % rec)
        for c in p["changes"]:
            lo = max(0, c["off"] - 4)
            hi = min(len(live[rec]), c["off"] + 5)
            lines.append("  0x%03X  %02X -> %02X     上下文 %s"
                         % (c["off"], live[rec][c["off"]], c["to"],
                            live[rec][lo:hi].hex(" ")))
    lines.append("")
    lines.append("# 设备/位置：变量存储 %s，记录 %s" % (p["guid"], ", ".join(p["records"])))
    lines.append("# 写完必须完全关机（poweroff）再开机，设置项在开机早期被固件消费。")
    txt = os.path.join(outdir, "changes.txt")
    with open(txt, "w", encoding="utf-8") as fh:
        fh.write("\n".join(lines) + "\n")
    say("改动表    %s" % txt)
    say("")
    say("离线导出不含任何写入动作。用法见 README 第 9 节。")
    return EXIT_OK


def cmd_apply(args):
    logpath = os.path.join(LOGDIR, "apply_%s.txt" % _stamp())
    say("insyde-nvram apply —— 通过 efivarfs 写入补丁字节")
    say("时间      %s" % time.strftime("%Y-%m-%d %H:%M:%S"))
    gate_root()

    p = parse_patch(args.patch)
    if not p["ok"]:
        flush_log(logpath)
        die(EXIT_PATCH, "补丁有问题: %s" % p["err"])
    say("补丁      %s" % p["name"])
    say("GUID      %s  记录 %s" % (p["guid"], ", ".join(p["records"])))
    gate_machine(args.force)
    say("门禁[加密] 检查中…")
    gate_encryption(args.force)

    live = {}
    for rec in p["records"]:
        try:
            attrs, data = read_var(p["guid"], rec)
        except RuntimeError as e:
            flush_log(logpath)
            die(EXIT_ENGINE, str(e))
        live[rec] = data
        say("读取      %-12s %d 字节  attrs=0x%08x" % (rec, len(data), attrs))

    gate_layout(p, {k: len(v) for k, v in live.items()}, args.force)
    gate_values(p, live, args.force)

    # 目标数据
    try:
        target = build_target(p, live)
    except RuntimeError as e:
        flush_log(logpath)
        die(EXIT_SANITY, str(e))

    say("")
    say("将要发生的改动：")
    for rec in p["records"]:
        for c in p["changes"]:
            say("   %-12s 0x%03X  0x%02X → 0x%02X" % (rec, c["off"], live[rec][c["off"]], c["to"]))
    say("")

    if args.dry_run:
        say("--dry-run：所有门禁通过，未写入任何字节。")
        flush_log(logpath)
        return EXIT_OK

    # 首次写入前保存原始字节（undo 只存第一份，绝不覆盖）
    os.makedirs(UNDODIR, exist_ok=True)
    for rec in p["records"]:
        undo = os.path.join(UNDODIR, "%s.%s.bin" % (p["slug"], rec))
        if not os.path.exists(undo):
            with open(undo, "wb") as fh:
                fh.write(live[rec])
            say("undo      %s （首次生成的原始字节）" % undo)
        else:
            say("undo      %s 已存在，保留最早那份" % undo)
        pre = os.path.join(UNDODIR, "pre_%s_%s.%s.bin" % (p["slug"], _stamp(), rec))
        with open(pre, "wb") as fh:
            fh.write(live[rec])

    if not args.yes:
        ans = input("确认写入？输入补丁名或 YES: ").strip()
        if ans not in ("YES", "yes", p["name"], p["slug"]):
            say("已取消")
            flush_log(logpath)
            return EXIT_PATCH

    ok_all = True
    for rec in p["records"]:
        say("")
        say("写入      %s …" % rec)
        try:
            cleared = write_var(p["guid"], rec, target[rec])
        except ChannelDenied as e:
            say("   失败: %s" % e)
            flush_log(logpath)
            die(EXIT_CHANNEL_DENIED,
                "通道被拦（退出码 13）。先跑 `sudo insyde-nvram probe --scan` 确认是"
                "整条 efivarfs 被封、还是只有这条变量被写保护，然后按 README 第 9 节换通道。")
        except RuntimeError as e:
            say("   失败: %s" % e)
            flush_log(logpath)
            die(EXIT_ENGINE, str(e))
        if cleared:
            say("   immutable 标志已清除")
        _a2, after = read_var(p["guid"], rec)

        if after == target[rec]:
            say("   校验: 与预期逐字节一致")
            continue

        # 允许固件顺带改写其他字节，但必须：目标字节到位 && 其余字节未被碰
        bad = [c["off"] for c in p["changes"] if after[c["off"]] != c["to"]]
        if bad:
            say("   校验: 目标字节没写进去 (%s)"
                % ", ".join("0x%03X" % b for b in bad))
            say("   用 `insyde-nvram restore %s` 回滚，或先完整关机再试" % p["slug"])
            ok_all = False
            continue
        extra = [i for i in range(min(len(after), len(live[rec])))
                 if after[i] != target[rec][i]]
        say("   校验: 目标字节到位，但固件另外改写了 %d 字节 (%s)"
            % (len(extra), ", ".join("0x%03X" % i for i in extra[:10])))
        say("   记录！这些字节不在补丁范围内，回滚文件仍然有效。")

    say("")
    if ok_all:
        say("完成。设置项由固件在开机时读取 —— 请**完全关机**（poweroff），")
        say("再开机才会生效。reboot 不算。")
        say("回滚: sudo insyde-nvram restore %s" % p["patch"])
    flush_log(logpath)
    return EXIT_OK if ok_all else EXIT_VERIFY


def cmd_restore(args):
    logpath = os.path.join(LOGDIR, "restore_%s.txt" % _stamp())
    gate_root()
    p = parse_patch(args.patch)
    if not p["ok"]:
        die(EXIT_PATCH, "补丁有问题: %s" % p["err"])
    say("回滚      %s" % p["name"])

    state, detail = detect_tpm_sealed_volumes()
    say("加密状态  %s（回滚只报告，不拦 —— 卷已经躺进恢复模式时，把 TPM 放回去才是修复）"
        % state)
    for d in detail:
        say("          " + d)

    restored = 0
    for rec in p["records"]:
        undo = os.path.join(UNDODIR, "%s.%s.bin" % (p["slug"], rec))
        if not os.path.exists(undo):
            say("   缺少 %s —— 没有这个 patch 的原始副本" % undo)
            continue
        orig = open(undo, "rb").read()
        try:
            _a, cur = read_var(p["guid"], rec)
        except RuntimeError as e:
            die(EXIT_ENGINE, str(e))
        if cur == orig:
            say("   %s 已经是原始字节，跳过" % rec)
            restored += 1
            continue
        if not args.yes:
            ans = input("写回 %s 的原始 %d 字节？输入 YES: " % (rec, len(orig))).strip()
            if ans != "YES":
                say("已取消")
                flush_log(logpath)
                return EXIT_PATCH
        try:
            write_var(p["guid"], rec, orig)
        except ChannelDenied as e:
            say("   失败: %s" % e)
            flush_log(logpath)
            die(EXIT_CHANNEL_DENIED, str(e))
        except RuntimeError as e:
            flush_log(logpath)
            die(EXIT_ENGINE, str(e))
        _a, after = read_var(p["guid"], rec)
        if after == orig:
            say("   %s 已恢复并校验一致" % rec)
            restored += 1
        else:
            say("   %s 恢复后仍不一致" % rec)
    say("")
    say("回滚完成 %d 个记录。完全关机后生效。" % restored)
    flush_log(logpath)
    return EXIT_OK


# ---------------------------------------------------------------------------
# CLI
# ---------------------------------------------------------------------------

def build_parser():
    ap = argparse.ArgumentParser(
        prog="insyde-nvram",
        description="Insyde H2O 笔记本 NVRAM 补丁工具（Linux / efivarfs 版）",
        epilog="先读 docs/how-it-works.md 和 DISCLAIMER.md。改动固件 NVRAM 可能变砖。")
    ap.add_argument("--version", action="version", version="insyde-nvram " + VERSION)
    sub = ap.add_subparsers(dest="cmd", required=True)

    s = sub.add_parser("status", help="只读状态探针（首次运行会生成 machine.txt）")
    s.add_argument("--json", action="store_true", help="机器可读输出（未实现时忽略）")
    s.set_defaults(func=cmd_status)

    s = sub.add_parser("list", help="列出 efivarfs 里的 Setup 类变量")
    s.add_argument("--guid")
    s.add_argument("--all", action="store_true", help="列出全部变量（含引导项/证书）")
    s.set_defaults(func=cmd_list)

    s = sub.add_parser("dump", help="打一份快照到 snapshots/")
    s.add_argument("--guid")
    s.add_argument("--record", action="append", help="只导出指定记录（可多次）")
    s.add_argument("--label", default="", help="快照标签，例如 before / after-biossave")
    s.set_defaults(func=cmd_dump)

    s = sub.add_parser("show", help="十六进制查看快照")
    s.add_argument("path")
    s.add_argument("--start", type=lambda x: int(x, 0), default=0)
    s.add_argument("--end", type=lambda x: int(x, 0), default=None)
    s.set_defaults(func=cmd_show)

    s = sub.add_parser("diff", help="比较两份快照，生成候选补丁（差分定位法）")
    s.add_argument("old")
    s.add_argument("new")
    s.add_argument("--out", help="把差异写成候选 .patch")
    s.add_argument("--guid", help="候选补丁里要填的 GUID")
    s.add_argument("--name", help="候选补丁的 NAME")
    s.set_defaults(func=cmd_diff)

    s = sub.add_parser("check", help="只读：显示补丁会动哪个字节、当前值是多少")
    s.add_argument("patch")
    s.set_defaults(func=cmd_check)

    s = sub.add_parser("apply", help="应用补丁（会修改 NVRAM）")
    s.add_argument("patch")
    s.add_argument("--dry-run", action="store_true", help="跑完所有门禁但不写入")
    s.add_argument("--yes", action="store_true", help="跳过交互确认")
    s.add_argument("--force", action="store_true", help="一次性跳过所有门禁（危险）")
    s.set_defaults(func=cmd_apply)

    s = sub.add_parser("restore", help="按 undo 副本逐字节回滚")
    s.add_argument("patch")
    s.add_argument("--yes", action="store_true")
    s.set_defaults(func=cmd_restore)

    s = sub.add_parser("export", help="离线导出目标字节与改动表（给 RU.EFI / H2OUVE 用）")
    s.add_argument("patch")
    s.add_argument("--out")
    s.set_defaults(func=cmd_export)

    s = sub.add_parser("tpm", help="fTPM 状态判定 + 打开 fTPM 的差分实验")
    s.add_argument("--baseline", action="store_true",
                   help="先打一份基线快照，并打印实验步骤")
    s.add_argument("--after", metavar="快照目录",
                   help="BIOS 里开过之后回来对比基线，判定是否生效并生成候选补丁")
    s.add_argument("--out", help="配合 --after 写出候选补丁")
    s.add_argument("--guid")
    s.set_defaults(func=cmd_tpm)

    s = sub.add_parser("probe", help="写通道探针：原样写回，不改任何值")
    s.add_argument("--record", default="Setup")
    s.add_argument("--guid")
    s.add_argument("--scan", action="store_true",
                   help="扫描全部 Setup 类变量 + 临时变量，判断是整条通道被封还是单变量被保护")
    s.add_argument("--yes", action="store_true")
    s.set_defaults(func=cmd_probe)

    return ap


def main(argv):
    ap = build_parser()
    args = ap.parse_args(argv)
    return args.func(args)


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv[1:]))
    except KeyboardInterrupt:
        print("\n中断")
        sys.exit(130)
