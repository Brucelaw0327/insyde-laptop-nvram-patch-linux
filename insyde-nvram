def _load_snapshot(path):
    """接受快照目录或单个 .bin。返回 {record: bytes}。"""
    out = {}
    if os.path.isdir(path):
        for fn in sorted(os.listdir(path)):
            if fn.endswith(".bin"):
                out[fn[:-4]] = open(os.path.join(path, fn), "rb").read()
    elif os.path.isfile(path):
        out[os.path.splitext(os.path.basename(path))[0]] = open(path, "rb").read()
    else:
        die(EXIT_PATCH, "找不到快照: %s" % path)
    return out


def cmd_dump(args):
    if not os.path.isdir(EFIVARS):
        die(EXIT_ENGINE, "efivarfs 不可用")
    label = args.label or "dump"
    outdir = os.path.join(SNAPDIR, "%s_%s" % (_stamp(), re.sub(r"[^\w.-]+", "_", label)))
    os.makedirs(outdir, exist_ok=True)
    global LAST_SNAPDIR
    LAST_SNAPDIR = outdir

    if args.guid:
        guid = args.guid.upper()
        names = [r["name"] for r in discover_setup_stores().get(guid, [])]
        if args.record:
            names = [n for n in names if n in args.record]
    else:
        stores = discover_setup_stores()
        target = [(g, [r["name"] for r in v]) for g, v in stores.items()
                  if any(r["name"] in SETUP_NAMES for r in v)]
        if not target:
            die(EXIT_ENGINE, "没找到 Setup 类变量，用 --guid/--record 指定")
        guid, names = target[0][0], target[0][1]
        if args.record:
            names = [n for n in names if n in args.record]

    meta = {"guid": guid, "time": time.strftime("%Y-%m-%d %H:%M:%S"),
            "identity": live_identity(), "records": {}}
    lines = ["# insyde-nvram dump  %s  guid=%s" % (meta["time"], guid),
             "# 偏移为变量数据内偏移（不含 efivarfs 的 4 字节属性头）", ""]
    for name in names:
        attrs, data = read_var(guid, name)
        with open(os.path.join(outdir, name + ".bin"), "wb") as fh:
            fh.write(data)
        meta["records"][name] = {"size": len(data), "attrs": attrs,
                                 "sha256": hashlib.sha256(data).hexdigest()}
        lines.append("== %s  %d 字节  attrs=0x%08x  sha256=%s"
                     % (name, len(data), attrs, meta["records"][name]["sha256"]))
        lines.append(hexdump(data))
        lines.append("")
    with open(os.path.join(outdir, "meta.json"), "w", encoding="utf-8") as fh:
        json.dump(meta, fh, indent=2, ensure_ascii=False)
    with open(os.path.join(outdir, "dump.txt"), "w", encoding="utf-8") as fh:
        fh.write("\n".join(lines) + "\n")

    # 兼容层：同时写一份 H2OUVE `-gv` 同格式的转储，让原仓库的
    # tools/ifr_locate.py verify / ve_parse.py 不改一行就能吃这份快照。
    allrecs = [r["name"] for r in discover_setup_stores().get(guid, [])]
    gv = []
    for idx, name in enumerate(allrecs):
        attrs, data = read_var(guid, name)
        gv.append('[%03X] "%s"' % (idx, name))
        gv.append("GUID: %s" % guid)
        gv.append("Attributes: 0x%02X" % attrs)
        gv.append("DataSize: 0x%X" % len(data))
        for off in range(0, len(data), 16):
            gv.append("%08X: %s" % (off, " ".join("%02X" % b for b in data[off:off + 16])))
        gv.append("")
    with open(os.path.join(outdir, "vars_live.txt"), "w", encoding="utf-8") as fh:
        fh.write("\n".join(gv) + "\n")

    say("快照已写入 %s" % outdir)
    for name, m in meta["records"].items():
        say("   %-14s %5d 字节  sha256=%s…" % (name, m["size"], m["sha256"][:16]))
    say("   vars_live.txt 为 H2OUVE -gv 同格式，可直接喂给 tools/ifr_locate.py verify")
    return EXIT_OK


