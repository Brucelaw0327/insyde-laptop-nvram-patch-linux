    say("")

    if state == "ON":
        say("VERDICT: fTPM 已开启")
        if _have("systemd-cryptenroll"):
            say("  想给 LUKS 绑 TPM2: systemd-cryptenroll --tpm2-device=auto --tpm2-pcrs=0+7 <设备>")
        return EXIT_OK

    if state == "FIRMWARE_ON_KERNEL_OFF":
        say("VERDICT: 固件开了但内核没接上（不是 NVRAM 问题，别改 setup 变量）")
        return EXIT_ENGINE

    say("VERDICT: fTPM 关闭（固件层，不是驱动问题）")
    say("")
    say("打开它有三条路，按代价排：")
    say("  1. BIOS 里直接开（最省事）—— 如果 setup 里看得见 TPM/fTPM 这一项")
    say("  2. 差分实验 —— 你在 BIOS 里开一次，本工具对比出到底是哪个字节变了，")
    say("     以后这一项就能写成补丁，不用再进 BIOS。见下面 --baseline / --after")
