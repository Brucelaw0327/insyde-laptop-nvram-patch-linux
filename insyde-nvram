GUID_RE = re.compile(
    r"^[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{12}$"
)

_LOG = []


def say(msg=""):
    print(msg)
    _LOG.append(str(msg))


def flush_log(path):
    try:
        os.makedirs(os.path.dirname(path), exist_ok=True)
        with open(path, "w", encoding="utf-8") as fh:
            fh.write("\n".join(_LOG) + "\n")
        say("日志      = %s" % path)
    except OSError:
        pass


def die(code, msg):
    say(msg)
    raise SystemExit(code)


