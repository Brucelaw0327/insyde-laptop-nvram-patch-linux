#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""insyde-nvram -- Insyde H2O 笔记本 NVRAM 补丁工具（Linux / efivarfs 版）

这是 Windows 版 insyde-laptop-nvram-patch 的 Linux 对照实现：
  * 补丁文件格式完全相同（NAME / VARSTORE / GUID / RECORDS / OFFSET+FROM+TO 或 CHANGE）
  * 身份门禁、逐字节回滚、写入后读回校验的逻辑保持一致
  * 写入通道由 H2OUVE 的 SMI 服务改成内核 efivarfs（SetVariable）

差别（因为平台不同，不是简化）：
  * 没有 H2OUVE、没有 segwindrv 内核驱动、没有"最小记录文件"。
    SetVariable 一次写整个变量数据，所以写入内容 = 当前字节 + 恰好这些改动。
  * BitLocker 门禁换成 LUKS/TPM2 密封卷门禁：凡是把密钥密封进 TPM 的卷，都拒绝写入。
  * 偏移一律指"变量数据内的偏移"（不含 efivarfs 的 4 字节属性头）。

退出码（与 Windows 版对齐，新增 13/14）：
  0  成功
  1  写入后校验失败
  2  补丁文件/参数错误
  3  未以 root 运行
  4  当前值不可读（盲写）
  5  合理性检查失败（目标数据不含预期值）
  6  缺少 machine.txt（写引擎绝不自己生成）
  7  身份门禁不匹配
  8  布局/取值门禁不匹配
  9  后端读写失败
  11 存在 TPM 密封的加密卷
  12 无法判定加密状态
  13 固件拒绝 OS 侧写入（通道被拦）
  14 写入被接受但字节被固件改写
"""

import argparse
import errno
import fcntl
import hashlib
import json
import os
import re
import subprocess
import sys
import time

VERSION = "1.0.0"

EFIVARS = "/sys/firmware/efi/efivars"
HERE = os.path.dirname(os.path.realpath(__file__))
SNAPDIR = os.path.join(HERE, "snapshots")
UNDODIR = os.path.join(HERE, "undo")
LOGDIR = os.path.join(HERE, "logs")
MACHINE = os.path.join(HERE, "machine.txt")

EXIT_OK = 0
EXIT_VERIFY = 1
EXIT_PATCH = 2
EXIT_NOT_ROOT = 3
EXIT_BLIND = 4
EXIT_SANITY = 5
EXIT_NO_MACHINE = 6
EXIT_IDENTITY = 7
EXIT_LAYOUT = 8
EXIT_ENGINE = 9
EXIT_ENC_LOCKED = 11
EXIT_ENC_UNKNOWN = 12
EXIT_CHANNEL_DENIED = 13
EXIT_CHANNEL_MUTATED = 14

# Insyde 的 Setup 变量存储通常就这两个记录名；只用于发现与展示，不预置任何偏移。
SETUP_NAMES = ("Setup", "Custom", "SetupData", "CustomDefaults")

FS_IOC_GETFLAGS = 0x80086601
FS_IOC_SETFLAGS = 0x40086602
FS_IMMUTABLE_FL = 0x00000010

GUID_RE = re.compile(
    r"^[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{12}$"
)

_LOG = []


def say(msg=""):
    print(msg)
    _LOG.append(str(msg))


def flush_log(path):
    try:
        os.makedirs(os.path.dirname(path), exist_ok=True)
        with open(path, "w", encoding="utf-8") as fh:
            fh.write("\n".join(_LOG) + "\n")
        say("日志      = %s" % path)
    except OSError:
        pass


def die(code, msg):
    say(msg)
    raise SystemExit(code)


