def gate_root():
    if os.geteuid() != 0:
        die(EXIT_NOT_ROOT, "没有 root 权限 —— 用 sudo 运行，或 ./run.sh 选项 4")


def gate_machine(force):
    ident = read_machine_file()
    if not any(ident.values()):
        if force:
            say("门禁[身份] 缺少 machine.txt —— --force 跳过（危险）")
            return
        die(EXIT_NO_MACHINE,
            "缺少 machine.txt。先运行 `insyde-nvram status` 生成基线，"
            "写引擎不会自己编一个。")
    live = live_identity()
    bad = []
    for k in ("BIOS", "BOARD", "MODEL"):
        want, got = ident.get(k), live.get(k)
        if want and want != got:
            bad.append("   %-5s machine.txt=%-24s 本机=%s" % (k, want, got))
        elif not want:
            bad.append("   %-5s machine.txt 里是空占位符" % k)
    if bad:
        say("门禁[身份] 不匹配：")
        for b in bad:
            say(b)
        if force:
            say("   --force 已跳过身份门禁（危险）")
            return
        die(EXIT_IDENTITY, "身份门禁拒绝执行。换机器/换 BIOS 后请重新生成 machine.txt。")
    say("门禁[身份] 通过  BIOS=%s BOARD=%s MODEL=%s"
        % (live["BIOS"], live["BOARD"], live["MODEL"]))


def gate_encryption(force):
    state, detail = detect_tpm_sealed_volumes()
    for d in detail:
        say("   " + d)
    if state == "sealed":
        if force:
            say("门禁[加密] 有 TPM2 密封的卷 —— --force 跳过（危险）")
            return
        die(EXIT_ENC_LOCKED,
            "门禁[加密] 存在把密钥密封进 TPM 的加密卷。先解除 TPM2 绑定"
            "（systemd-cryptenroll --tpm2-device=none 或 luksRemoveKey 对应 token），"
            "否则本次改动会让那个卷下次开机进不了系统。")
    if state == "unknown":
        if force:
            say("门禁[加密] 无法判定 —— --force 跳过（危险）")
            return
        die(EXIT_ENC_UNKNOWN, "门禁[加密] 无法判定加密状态，需要人工确认后再来。")
    say("门禁[加密] 通过（没有 TPM 密封的卷）")


def gate_layout(patch, live_sizes, force):
    undo = os.path.join(UNDODIR, patch["slug"] + ".bin")
    problems = []
    if patch.get("size"):
        for name, size in live_sizes.items():
            if size != patch["size"]:
                problems.append("   %s 实际 %d 字节，补丁声明 %d 字节"
                                % (name, size, patch["size"]))
    if os.path.exists(undo):
        want = os.path.getsize(undo)
        for name, size in live_sizes.items():
            if size != want:
                problems.append("   %s 实际 %d 字节，首次写入时的基线 %d 字节"
                                % (name, size, want))
    if problems:
        say("门禁[布局] 不匹配：")
        for p in problems:
            say(p)
        if force:
            say("   --force 已跳过布局门禁（危险）")
            return
        die(EXIT_LAYOUT, "门禁[布局] 变量大小/布局变了（刷过 BIOS？清过 CMOS？）—— 重新定位偏移。")
    say("门禁[布局] 通过（%s）"
        % ", ".join("%s=%dB" % kv for kv in live_sizes.items()))


def gate_values(patch, live, force):
    """live: {record: bytes}。返回 [(record, off, cur)]，不匹配则退出。"""
    hits = []
    bad = []
    for rec in patch["records"]:
        data = live.get(rec)
        if data is None:
            bad.append("   %s 读不到" % rec)
            continue
        for c in patch["changes"]:
            if c["off"] >= len(data):
                bad.append("   %s 偏移 0x%X 超出变量长度 %d" % (rec, c["off"], len(data)))
                continue
            cur = data[c["off"]]
            hits.append((rec, c["off"], cur))
            if cur != c["from"]:
                if cur == c["to"]:
                    bad.append("   %s 偏移 0x%X 已经是目标值 0x%02X（这条改动已生效或无需改动）"
                               % (rec, c["off"], cur))
                else:
                    bad.append("   %s 偏移 0x%X 当前 0x%02X，补丁要求 FROM=0x%02X"
                               % (rec, c["off"], cur, c["from"]))
    if bad:
        say("门禁[取值] 不匹配：")
        for b in bad:
            say(b)
        if force:
            say("   --force 已跳过取值门禁（危险：将按补丁写死值，不再核对旧值）")
            return hits
        die(EXIT_LAYOUT, "门禁[取值] 拒绝盲写。偏移不是你以为的那个，或者已经改过了。")
    say("门禁[取值] 通过（%d 处改动全部对上旧值）" % len(patch["changes"]))
    return hits


